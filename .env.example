# ============================================================================
# Lucky Travel Ethiopia - environment template
# ============================================================================
# Copy this file to .env.local for local development:
#   PowerShell: Copy-Item .env.example .env.local
#   bash:       cp .env.example .env.local
#
# NEVER commit real credentials. Use a managed secret store in staging and
# production. Only variables prefixed with NEXT_PUBLIC_ are sent to browsers.
# Empty values must be filled before the related phase can be activated.
# ============================================================================

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
NODE_ENV=development
NEXT_PUBLIC_APP_NAME=Lucky Travel Ethiopia
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_TIMEZONE=Africa/Addis_Ababa
DEFAULT_LOCALE=en
SUPPORTED_LOCALES=en,am
LOG_LEVEL=debug
REQUEST_ID_HEADER=x-request-id

# Stable across all application instances. Required by Next.js Server Actions
# when self-hosting with more than one instance. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# MongoDB
# ---------------------------------------------------------------------------
# Production must use a replica set or sharded cluster so multi-document
# transactions are available. Local development needs a single-node replica
# set; a plain standalone mongod is not sufficient for payment/selection work.
MONGODB_URI=mongodb://127.0.0.1:27017/lucky_travel?replicaSet=rs0
MONGODB_DB_NAME=lucky_travel
MONGODB_MAX_POOL_SIZE=50
MONGODB_MIN_POOL_SIZE=5
MONGODB_SERVER_SELECTION_TIMEOUT_MS=10000
MONGODB_AUTO_INDEX=false

# ---------------------------------------------------------------------------
# Authentication and sessions
# ---------------------------------------------------------------------------
# HMAC pepper used when hashing session and one-time tokens. Never sent to the
# client. Rotating this value invalidates all sessions and outstanding tokens.
AUTH_SECRET=
SESSION_COOKIE_NAME=lte_session
SESSION_TTL_HOURS=720
SESSION_IDLE_TIMEOUT_MINUTES=10080
SESSION_ROTATION_HOURS=24

# AES-256-GCM key material for encrypting TOTP secrets at rest. Base64-encoded
# 32 bytes. Required before administrator MFA can be enabled.
MFA_ENCRYPTION_KEY=

# Optional bot protection for public auth endpoints (Phase 4).
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Initial administrator provisioning is performed by a one-time CLI command,
# not by hardcoded credentials. These values are read only by that command.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_NAME=

# ---------------------------------------------------------------------------
# Redis, rate limiting, caching and jobs
# ---------------------------------------------------------------------------
# Required in production. Local Redis is sufficient for development.
REDIS_URL=redis://127.0.0.1:6379
REDIS_KEY_PREFIX=lte
REDIS_TLS=false
RATE_LIMIT_ENABLED=true
PAYMENT_RECONCILE_INTERVAL_MINUTES=10
SELECTION_JOB_POLL_INTERVAL_SECONDS=5
WORKER_CONCURRENCY=5

# Shared remote cache handler (Phase 12, only if measurements justify it).
REMOTE_CACHE_ENABLED=false

# ---------------------------------------------------------------------------
# Object storage and images
# ---------------------------------------------------------------------------
# S3-compatible storage (for example Cloudflare R2, AWS S3 or MinIO locally).
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
S3_PUBLIC_BASE_URL=
S3_SIGNED_URL_TTL_SECONDS=300
UPLOAD_MAX_BYTES=10485760
UPLOAD_ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp
IMAGE_MAX_DIMENSION=4096

# ---------------------------------------------------------------------------
# Payments - Telebirr
# ---------------------------------------------------------------------------
# mock     = development/test only, clearly labelled, never production
# telebirr = official merchant integration; disabled until credentials and
#            provider approval are verified
PAYMENT_PROVIDER=mock
PAYMENTS_LIVE_ENABLED=false
ENABLE_MOCK_PAYMENTS=true

# Field names below are placeholders for the official merchant agreement.
# Do not invent endpoints, keys, signatures or callback formats. The exact
# values and supported flow are completed in Phase 8 from official Telebirr
# merchant documentation and credentials.
TELEBIRR_BASE_URL=
TELEBIRR_APP_ID=
TELEBIRR_APP_SECRET=
TELEBIRR_MERCHANT_CODE=
TELEBIRR_PRIVATE_KEY=
TELEBIRR_PUBLIC_KEY=
TELEBIRR_CALLBACK_URL=
TELEBIRR_RETURN_URL=
TELEBIRR_TIMEOUT_MS=30000

# ---------------------------------------------------------------------------
# Email, SMS and notifications
# ---------------------------------------------------------------------------
# console = development only; smtp/resend = configured provider
EMAIL_PROVIDER=console
EMAIL_FROM=Lucky Travel Ethiopia <no-reply@example.com>
EMAIL_REPLY_TO=
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false

# Optional until a supported Ethiopian SMS provider is contracted.
SMS_PROVIDER=disabled
SMS_API_KEY=
SMS_SENDER_ID=

# ---------------------------------------------------------------------------
# Observability
# ---------------------------------------------------------------------------
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=lucky-travel-ethiopia

# ---------------------------------------------------------------------------
# Feature flags and legal gates
# ---------------------------------------------------------------------------
FEATURE_CUSTOM_PLANS=false
FEATURE_REVIEWS=true
FEATURE_PUBLIC_SELECTION_DISPLAY=true
FEATURE_PRIZE_SELECTIONS=false
FEATURE_AMHARIC=true
FEATURE_ETHIOPIAN_CALENDAR=false

# Paid prize/selection functionality must remain disabled until all of the
# following are recorded and approved in the platform settings.
LEGAL_REVIEW_REFERENCE=
LEGAL_APPROVED_AT=
TELEBIRR_LIVE_APPROVED_AT=

# ---------------------------------------------------------------------------
# Development and test helpers
# ---------------------------------------------------------------------------
# Demo content must never be presented as verified production destination data.
SEED_DEMO_CONTENT=false
SEED_DEMO_ADMIN_EMAIL=
E2E_BASE_URL=http://localhost:3000
E2E_MOCK_PAYMENTS=true
